# Copy to .env (same directory as docker-compose.production.yml) and adjust
# if needed -- docker compose reads .env automatically. No value here is a
# secret; the demo requires no credentials at runtime (see task item 22).
# This file documents the *names* only, with safe defaults, so nothing
# sensitive ever needs to enter git, the Dockerfiles, or the compose file.

# Same-origin production: leave empty so the browser calls /api/v1/... on
# whatever host actually served the page (e.g.
# https://gaba.eventdecor.co.il/api/v1/...). Only used at frontend BUILD
# time (NEXT_PUBLIC_API_BASE_URL is inlined into the client bundle).
NEXT_PUBLIC_API_BASE_URL=

# Allowed browser Origins for the backend's CORS middleware. Same-origin
# production normally never triggers CORS at all (see
# docker-compose.production.yml); set this to the real public domain
# defensively, or to whatever origin is hitting the API directly during
# local debugging.
CORS_ALLOW_ORIGINS=https://gaba.eventdecor.co.il

# SQLite (default) is sufficient for this demo. Only set this if pointing at
# an external PostgreSQL instance is ever actually needed.
# DATABASE_URL=sqlite:///./gabay_pricing.db
